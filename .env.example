# ====================================
# EXEMPLO DE CONFIGURAÇÃO - .env
# ====================================
# Copie este arquivo para .env e ajuste os valores

# Flask Configuration
SECRET_KEY=MUDE-ESTA-CHAVE-EM-PRODUCAO-use-algo-aleatorio-e-complexo
FLASK_ENV=production
FLASK_DEBUG=False

# Database - SQLite (padrão)
DATABASE_URL=sqlite:////app/data/provas.db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,xlsx,xls,ppt,pptx

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Logging
LOG_LEVEL=INFO

# ====================================
# Integração Linx (db_puket em db01) — opcional, read-only
# ====================================
# Setar LINX_DB_ENABLED=true ativa o módulo Linx (endpoints + botões "Buscar no ERP").
# Sem credenciais válidas a UI fica oculta — não derruba o app.
LINX_DB_ENABLED=false
LINX_DB_HOST=db01.grupounico.com
LINX_DB_PORT=1433
LINX_DB_NAME=db_puket
LINX_DB_USER=
LINX_DB_PASSWORD=
LINX_DB_DRIVER=ODBC Driver 18 for SQL Server
LINX_DB_TIMEOUT=5
LINX_CACHE_TTL=3600
